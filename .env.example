# Google Places API (New). Enable "Places API (New)" in Google Cloud and restrict the key to it.
# Billing must be linked to the GCP project or every call returns REQUEST_DENIED.
GOOGLE_PLACES_API_KEY=

# Supabase — optional. Without these the CLI just writes CSV/JSON to out/.
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Service role key: Dashboard → Project Settings → API Keys → service_role.
# This bypasses RLS and can read and write every table. Keep it in .env only —
# never commit it, never ship it to a browser, never put it in a Next.js
# NEXT_PUBLIC_* var. The dashboard uses the publishable key instead.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: how many sites to scan in parallel (default 4)
SCAN_CONCURRENCY=4

# Optional: path to a Chromium binary if you don't want Playwright to download one
CHROMIUM_PATH=
